# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of browser origins allowed by CORS / Socket.IO
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/reviewslot

# ---- Auth ----
# Required. Use a long random value (>= 32 chars); e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
# Local development ONLY (refused when NODE_ENV=production): accept this fixed 6-digit code
# instead of a random one, so you can log in without SMTP. Leave empty otherwise.
DEV_FIXED_OTP=

# ---- Email (Nodemailer / Gmail app password) ----
# REQUIRED in production: the server refuses to start without them, because sign-in codes are sent by email.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Review Management System

# ---- File uploads ----
# Files are stored on local disk. In production point this at a PERSISTENT volume (it is checked for write access at boot).
UPLOAD_DIR=./uploads
# Optional antivirus hook: an executable run on every upload. Exit code 0 = clean, 1 = infected (file is quarantined and
# rejected), anything else = scanner error. "{file}" in the arguments is replaced by the path of the file to scan.
# Example (ClamAV daemon): UPLOAD_SCANNER_BIN=/usr/bin/clamdscan   UPLOAD_SCANNER_ARGS=["--no-summary","--fdpass","{file}"]
UPLOAD_SCANNER_BIN=
UPLOAD_SCANNER_ARGS=["{file}"]
UPLOAD_SCANNER_TIMEOUT_MS=30000
# true = if the scanner itself fails or times out, reject the upload (recommended once a scanner is in place)
UPLOAD_SCAN_REQUIRED=false

# ---- Reverse proxy and rate limiting ----
# Number of proxy hops in front of the API (so the real client IP is used). 0 if the API is exposed directly.
TRUST_PROXY=1
# Limits are per client IP per window and kept in memory PER API INSTANCE. A campus often shares ONE public IP, so the
# defaults are generous; raise them (or enforce limits at your proxy) rather than lowering them.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=6000
RATE_LIMIT_AUTH_MAX=300
RATE_LIMIT_EXPORT_MAX=30
RATE_LIMIT_UPLOAD_MAX=300

# ---- Several API instances (optional) ----
# With more than one instance, set this so realtime hints reach users connected to any instance. Needs Redis.
REDIS_URL=

# ---- First-run bootstrap (npm run bootstrap:hod) ----
HOD_EMAIL=
HOD_NAME=Head of Department
